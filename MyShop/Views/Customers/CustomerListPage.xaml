<Page
    x:Class="MyShop.Views.Customers.CustomerListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controlsprimitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    xmlns:models="using:MyShop.Models.Customers"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Danh Sách Khách Hàng"
                          Style="{StaticResource TitleTextBlockStyle}"
                          FontWeight="Bold"/>
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0">
                    <Run Text="Tổng số:"/>
                    <Run Text="{x:Bind ViewModel.CustomerCount, Mode=OneWay}"/>
                    <Run Text="khách hàng"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- Create New Customer -->
                <Button Click="AddCustomerButton_Click"
                       Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock Text="Thêm Khách Hàng"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="Tìm theo tên hoặc số điện thoại..."
                         Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                        <TextBlock Text="Tìm kiếm"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="2">
            <!-- Progress Ring -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                         Width="60"
                         Height="60"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>

            <!-- DataGrid -->
            <controls:DataGrid x:Name="CustomersDataGrid"
                              ItemsSource="{x:Bind ViewModel.FilteredCustomers, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CanUserResizeColumns="True"
                              SelectionMode="Single"
                              ColumnHeaderHeight="44"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}">

                <controls:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="controlsprimitives:DataGridColumnHeader">
                        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                    </Style>
                </controls:DataGrid.ColumnHeaderStyle>

                <controls:DataGrid.Columns>
                    <!-- Name Column -->
                    <controls:DataGridTextColumn Header="Khách Hàng"
                                                Binding="{Binding Name}"
                                                Width="2*"/>

                    <!-- Phone Column -->
                    <controls:DataGridTextColumn Header="Số Điện Thoại"
                                                Binding="{Binding PhoneNumber}"
                                                Width="150"/>

                    <!-- Address Column -->
                    <controls:DataGridTextColumn Header="Địa Chỉ"
                                                Binding="{Binding FormattedAddress}"
                                                Width="*"/>

                    <!-- Total Spent Column -->
                    <controls:DataGridTemplateColumn Header="Tổng Chi Tiêu" Width="150">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Customer">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedTotalSpent}"
                                              FontWeight="Bold"
                                              FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- Loyalty Status Column -->
                    <controls:DataGridTemplateColumn Header="Hạng" Width="120">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Customer">
                                <Border Background="#FEF3C7"
                                       CornerRadius="10"
                                       Padding="8,4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind LoyaltyStatus}"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              Foreground="#D97706"
                                              TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- Actions Column -->
                    <controls:DataGridTemplateColumn Header="Thao Tác" Width="180">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Customer">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <!-- Edit Button -->
                                    <Button Click="EditButton_Click"
                                           Tag="{x:Bind}"
                                           Style="{StaticResource AccentButtonStyle}"
                                           Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            <TextBlock Text="Sửa"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Delete Button -->
                                    <Button Click="DeleteButton_Click"
                                           Tag="{x:Bind}"
                                           Height="32"
                                           Background="#E81123"
                                           BorderBrush="#D13438"
                                           BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White"/>
                                            <TextBlock Text="Xóa" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <!-- Empty State -->
            <StackPanel Spacing="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,48,0,0"
                       Visibility="{x:Bind ViewModel.FilteredCustomers.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                <FontIcon Glyph="&#xE77B;" FontSize="64" Opacity="0.3"/>
                <TextBlock Text="Không có khách hàng nào"
                          FontSize="18"
                          Opacity="0.6"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Pagination -->
        <Border Grid.Row="3"
               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
               BorderThickness="1"
               CornerRadius="8"
               Padding="16"
               Margin="0,16,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Opacity="0.7">
                    <Run Text="Hiển thị"/>
                    <Run Text="{x:Bind ViewModel.PageInfo, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Spacing="12">

                    <!-- Page Size Selector -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Số dòng:" VerticalAlignment="Center" Opacity="0.7"/>
                        <ComboBox ItemsSource="{x:Bind ViewModel.AvailablePageSizes}"
                                  SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}"
                                  MinWidth="70"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.GoToPreviousPageCommand}"
                           IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}"
                           Padding="12,8"
                           MinWidth="100">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                            <TextBlock Text="Trước"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.GoToNextPageCommand}"
                           IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}"
                           Padding="12,8"
                           MinWidth="100">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Sau"/>
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
