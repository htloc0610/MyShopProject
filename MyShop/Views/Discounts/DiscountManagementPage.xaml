<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyShop.Views.Discounts.DiscountManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MyShop.Models.Discounts"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:controlsprimitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d">

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản Lý Mã Giảm Giá" 
                          Style="{StaticResource TitleTextBlockStyle}"
                          FontWeight="Bold"/>
                <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0">
                    <Run Text="Tổng số:"/>
                    <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}"/>
                    <Run Text="mã giảm giá"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- Toggle Filter Button -->
                <ToggleButton IsChecked="{x:Bind ViewModel.IsFilterVisible, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                        <TextBlock Text="Bộ lọc"/>
                    </StackPanel>
                </ToggleButton>

                <Button Style="{StaticResource AccentButtonStyle}"
                       Command="{x:Bind ViewModel.PrepareAddCommand}"
                       Click="AddButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock Text="Thêm Mã Giảm Giá"/>
                    </StackPanel>
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Section -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                Visibility="{x:Bind ViewModel.IsFilterVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- First Row: Search and Status -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                            PlaceholderText="Tìm kiếm theo mã giảm giá..."
                            Text="{x:Bind ViewModel.SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center">
                        <TextBox.Header>
                            <TextBlock Text="Tìm kiếm" FontWeight="SemiBold"/>
                        </TextBox.Header>
                    </TextBox>

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="2"
                             ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                             SelectedValue="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                             DisplayMemberPath="Display"
                             SelectedValuePath="Value"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center">
                        <ComboBox.Header>
                            <TextBlock Text="Trạng thái" FontWeight="SemiBold"/>
                        </ComboBox.Header>
                    </ComboBox>
                </Grid>

                <!-- Second Row: Amount Range -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Min Amount -->
                    <NumberBox Grid.Column="0"
                              Value="{x:Bind ViewModel.MinAmount, Mode=TwoWay}"
                              PlaceholderText="0"
                              SpinButtonPlacementMode="Compact"
                              Minimum="0"
                              VerticalAlignment="Center">
                        <NumberBox.Header>
                            <TextBlock Text="Số tiền tối thiểu (VNĐ)" FontWeight="SemiBold"/>
                        </NumberBox.Header>
                    </NumberBox>

                    <!-- Max Amount -->
                    <NumberBox Grid.Column="2"
                              Value="{x:Bind ViewModel.MaxAmount, Mode=TwoWay}"
                              PlaceholderText="0"
                              SpinButtonPlacementMode="Compact"
                              Minimum="0"
                              VerticalAlignment="Center">
                        <NumberBox.Header>
                            <TextBlock Text="Số tiền tối đa (VNĐ)" FontWeight="SemiBold"/>
                        </NumberBox.Header>
                    </NumberBox>
                </Grid>

                <!-- Third Row: Date Range and Buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Start Date -->
                    <CalendarDatePicker Grid.Column="0"
                                       Date="{x:Bind ViewModel.FilterStartDate, Mode=TwoWay}"
                                       PlaceholderText="Chọn ngày bắt đầu"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center">
                        <CalendarDatePicker.Header>
                            <TextBlock Text="Ngày bắt đầu" FontWeight="SemiBold"/>
                        </CalendarDatePicker.Header>
                    </CalendarDatePicker>

                    <!-- End Date -->
                    <CalendarDatePicker Grid.Column="2"
                                       Date="{x:Bind ViewModel.FilterEndDate, Mode=TwoWay}"
                                       PlaceholderText="Chọn ngày kết thúc"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center">
                        <CalendarDatePicker.Header>
                            <TextBlock Text="Ngày kết thúc" FontWeight="SemiBold"/>
                        </CalendarDatePicker.Header>
                    </CalendarDatePicker>

                    <!-- Filter Buttons -->
                    <StackPanel Grid.Column="4" 
                               Orientation="Horizontal" 
                               Spacing="8" 
                               VerticalAlignment="Bottom">
                        <Button Command="{x:Bind ViewModel.ApplyFiltersCommand}"
                               Style="{StaticResource AccentButtonStyle}"
                               Width="100">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                <TextBlock Text="Lọc"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Command="{x:Bind ViewModel.ClearFiltersCommand}"
                               Width="120">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" FontSize="16"/>
                                <TextBlock Text="Xóa lọc"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Grid Grid.Row="2">
            <!-- Progress Ring -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                         Width="60"
                         Height="60"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>

            <!-- DataGrid -->
            <controls:DataGrid x:Name="DiscountsDataGrid"
                              ItemsSource="{x:Bind ViewModel.Discounts, Mode=OneWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="False"
                              SelectionMode="Single"
                              ColumnHeaderHeight="44"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverseConverter}}">

                <controls:DataGrid.ColumnHeaderStyle>
                    <Style TargetType="controlsprimitives:DataGridColumnHeader">
                        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                    </Style>
                </controls:DataGrid.ColumnHeaderStyle>

                <controls:DataGrid.Columns>
                    <!-- Code Column -->
                    <controls:DataGridTextColumn Header="Mã"
                                                Binding="{Binding Code}"
                                                Width="1.5*"/>

                    <!-- Amount Column -->
                    <controls:DataGridTextColumn Header="Số Tiền"
                                                Binding="{Binding FormattedAmount}"
                                                Width="1.2*"/>

                    <!-- Usage Column -->
                    <controls:DataGridTextColumn Header="Đã Dùng"
                                                Binding="{Binding UsageDisplay}"
                                                Width="1*"/>

                    <!-- Start Date Column -->
                    <controls:DataGridTextColumn Header="Ngày Bắt Đầu"
                                                Binding="{Binding FormattedStartDate}"
                                                Width="1.3*"/>

                    <!-- End Date Column -->
                    <controls:DataGridTextColumn Header="Ngày Kết Thúc"
                                                Binding="{Binding FormattedEndDate}"
                                                Width="1.3*"/>

                    <!-- Status Column -->
                    <controls:DataGridTemplateColumn Header="Trạng Thái"
                                                    Width="1.2*">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Discount">
                                <Border CornerRadius="10"
                                       Padding="8,4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Color="{x:Bind Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{x:Bind Status}" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              Foreground="White"
                                              TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>

                    <!-- Actions Column -->
                    <controls:DataGridTemplateColumn Header="Thao Tác"
                                                    Width="1.8*">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Discount">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <!-- Edit Button -->
                                    <Button Click="EditButton_Click"
                                           Tag="{x:Bind}"
                                           Style="{StaticResource AccentButtonStyle}"
                                           Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                            <TextBlock Text="Sửa"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Delete Button -->
                                    <Button Click="DeleteButton_Click"
                                           Tag="{x:Bind}"
                                           Height="32"
                                           Background="#E81123"
                                           BorderBrush="#D13438"
                                           BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White"/>
                                            <TextBlock Text="Xóa" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>

            <!-- Empty State -->
            <StackPanel Spacing="12" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,48,0,0"
                       Visibility="{x:Bind ViewModel.Discounts.Count, Mode=OneWay, Converter={StaticResource CountToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8F1;" FontSize="64" Opacity="0.3"/>
                <TextBlock Text="Không có mã giảm giá nào" 
                          FontSize="18" 
                          Opacity="0.6"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Pagination -->
        <Border Grid.Row="3" 
               Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
               BorderThickness="1"
               CornerRadius="8"
               Padding="16"
               Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Page Size Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="0,0,16,0">
                    <TextBlock Text="Số lượng/trang:" 
                              VerticalAlignment="Center"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.PageSizeOptions}"
                             SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}"
                             Width="80"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Page Info -->
                <TextBlock Grid.Column="1"
                          Text="{x:Bind ViewModel.PaginationInfo, Mode=OneWay}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Style="{StaticResource BodyStrongTextBlockStyle}"/>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.GoToPreviousPageCommand}"
                           IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}"
                           Width="100">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                            <TextBlock Text="Trước"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.GoToNextPageCommand}"
                           IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}"
                           Width="100">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Sau"/>
                            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add/Edit Dialog -->
        <ContentDialog x:Name="DiscountDialog"
                      Title="Chi tiết mã giảm giá"
                      PrimaryButtonText="Lưu"
                      SecondaryButtonText="Hủy"
                      PrimaryButtonClick="DiscountDialog_PrimaryButtonClick"
                      SecondaryButtonClick="DiscountDialog_SecondaryButtonClick">
            <ScrollViewer>
                <StackPanel Spacing="16" MinWidth="400">
                    <!-- Code -->
                    <TextBox Header="Mã *" 
                            PlaceholderText="VD: GIAM50K, CHAOKHACH10"
                            Text="{x:Bind ViewModel.EditCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MaxLength="50"/>

                    <!-- Description -->
                    <TextBox Header="Mô tả" 
                            PlaceholderText="Mô tả (không bắt buộc)"
                            Text="{x:Bind ViewModel.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Height="80"/>

                    <!-- Amount -->
                    <NumberBox Header="Số tiền giảm *" 
                              PlaceholderText="Nhập số tiền"
                              Value="{x:Bind ViewModel.EditAmount, Mode=TwoWay}"
                              Minimum="0"
                              SpinButtonPlacementMode="Inline"/>

                    <!-- Start Date -->
                    <CalendarDatePicker Header="Ngày bắt đầu *"
                                       Date="{x:Bind ViewModel.EditStartDate, Mode=TwoWay}"/>

                    <!-- End Date -->
                    <CalendarDatePicker Header="Ngày kết thúc *"
                                       Date="{x:Bind ViewModel.EditEndDate, Mode=TwoWay}"/>

                    <!-- Usage Limit -->
                    <NumberBox Header="Giới hạn sử dụng" 
                              PlaceholderText="Để trống nếu không giới hạn"
                              Value="{x:Bind ViewModel.EditUsageLimit, Mode=TwoWay}"
                              Minimum="1"
                              SpinButtonPlacementMode="Inline"/>

                    <!-- Active Status -->
                    <ToggleSwitch Header="Trạng thái" 
                                 IsOn="{x:Bind ViewModel.EditIsActive, Mode=TwoWay}"
                                 OnContent="Đang hoạt động"
                                 OffContent="Đã tắt"/>

                    <TextBlock Text="* Bắt buộc" 
                              FontSize="12" 
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
